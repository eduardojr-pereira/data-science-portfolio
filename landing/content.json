  "about": [
    {
      "label": {
        "en": "Background",
        "pt-BR": "Formação"
      },
      "eyebrow": {
        "en": "Economics × Data Science",
        "pt-BR": "Economia × Ciência de Dados"
      },
      "title": {
        "en": "From economics to data",
        "pt-BR": "Da economia aos dados"
      },
      "body": {
        "en": "My background in Economics at the Federal University of Viçosa (UFV) and postgraduate studies in Data Science at PUC bring together economic reasoning, statistics and computational methods.",
        "pt-BR": "Minha formação em Ciências Econômicas pela Universidade Federal de Viçosa (UFV) e a pós-graduação em Ciência de Dados pela PUC conectam raciocínio econômico, estatística e métodos computacionais."
      },
      "detail": {
        "en": "Economics · UFV / Data Science · PUC",
        "pt-BR": "Ciências Econômicas · UFV / Ciência de Dados · PUC"
      }
    },
    {
      "label": {
        "en": "Journey",
        "pt-BR": "Trajetória"
      },
      "eyebrow": {
        "en": "Different perspectives",
        "pt-BR": "Diferentes perspectivas"
      },
      "title": {
        "en": "A non-linear path",
        "pt-BR": "Uma trajetória não linear"
      },
      "body": {
        "en": "My professional experience spans construction, video editing and the municipal market. These different environments are part of the perspective I bring to my transition into data and analytics.",
        "pt-BR": "Minha experiência profissional passa pela construção civil, edição de vídeo e mercado municipal. Esses diferentes ambientes fazem parte da perspectiva que levo à minha transição para dados e analytics."
      },
      "detail": {
        "en": "Practical experience · Professional transition",
        "pt-BR": "Experiência prática · Transição profissional"
      }
    },
    {
      "label": {
        "en": "Approach",
        "pt-BR": "Abordagem"
      },
      "eyebrow": {
        "en": "From questions to evidence",
        "pt-BR": "Das perguntas às evidências"
      },
      "title": {
        "en": "Make data meaningful",
        "pt-BR": "Dar sentido aos dados"
      },
      "body": {
        "en": "I approach analytical problems through economic reasoning, exploratory analysis, statistical methods and reproducible workflows. I am interested in analytics, business intelligence, market intelligence and machine learning applied to decisions.",
        "pt-BR": "Abordo problemas analíticos por meio do raciocínio econômico, análise exploratória, métodos estatísticos e fluxos reprodutíveis. Tenho interesse em analytics, business intelligence, inteligência de mercado e aprendizado de máquina aplicado a decisões."
      },
      "detail": {
        "en": "Python · Statistics · Data visualization · Machine learning",
        "pt-BR": "Python · Estatística · Visualização de dados · Aprendizado de máquina"
      }
    },
    {
      "label": {
        "en": "Knowledge Base",
        "pt-BR": "Base de Conhecimento"
      },
      "eyebrow": {
        "en": "Continuous learning",
        "pt-BR": "Aprendizado contínuo"
      },
      "title": {
        "en": "Learning in the open",
        "pt-BR": "Aprendizado aberto"
      },
      "body": {
        "en": "My Data Science Knowledge Base organizes technical studies, notebooks and supporting material across eleven study areas. It complements the portfolio by documenting the foundations behind the projects.",
        "pt-BR": "Minha Base de Conhecimento em Ciência de Dados organiza estudos técnicos, notebooks e materiais de apoio em onze áreas. Ela complementa o portfólio ao documentar os fundamentos dos projetos."
      },
      "detail": {
        "en": "11 study areas · 139 notebooks",
        "pt-BR": "11 áreas de estudo · 139 notebooks"
      },
